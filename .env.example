# Copia este fichero a `.env` y rellena los valores. `.env` nunca debe subirse al repositorio.

# Cadena de conexión de MongoDB (local o Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/app-music

# Secreto para firmar los JWT (mínimo 16 caracteres). Genera uno con:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=30d

PORT=4000

# Orígenes permitidos por CORS, separados por comas ("*" para cualquiera)
CORS_ORIGIN=http://localhost:4200,https://david-matos-salvador.github.io

# Carpeta donde se guardan imágenes y audios subidos
UPLOAD_DIR=upload
